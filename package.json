{
  "name": "@abdelrahmanhsn/jira-mcp",
  "type": "module",
  "version": "1.8.0",
  "description": "MCP server for Jira — query your tickets, active sprints, and issue details from any AI IDE (GitHub Copilot, Cursor, Claude Desktop)",
  "main": "dist/index.js",
  "bin": {
    "jira-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "mcp",
    "jira",
    "atlassian",
    "model-context-protocol",
    "ai",
    "copilot",
    "cursor",
    "claude",
    "sprint",
    "tickets",
    "devtools"
  ],
  "author": {
    "name": "Abdelrahman Hassan",
    "email": "abdelrahmanhsn1@gmail.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": ""
  },
  "homepage": "https://www.npmjs.com/package/@abdelrahmanhsn/jira-mcp",
  "bugs": {
    "url": ""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.15.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "eslint": "^9.39.4",
    "prettier": "^3.8.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  }
}
